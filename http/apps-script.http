### Get Order By Invitation Slug
POST {{appsScriptUrl}}
Content-Type: application/json
Accept: application/json

{
  "secret": "{{sharedSecret}}",
  "action": "getOrderByInvitationSlug",
  "payload": {
    "invitationSlug": "{{invitationSlug}}"
  }
}

### Update Order Status
POST {{appsScriptUrl}}
Content-Type: application/json
Accept: application/json

{
  "secret": "{{sharedSecret}}",
  "action": "updateOrderStatus",
  "payload": {
    "orderId": "{{orderId}}",
    "status": "published",
    "updatedAt": "2026-03-13T08:00:00.000Z",
    "publishedAt": "2026-03-13T08:00:00.000Z",
    "publishedBy": "admin",
    "lastUpdatedBy": "admin",
    "lastUpdateType": "publish",
    "lastUpdateNote": "Invitation siap dipublikasikan."
  }
}

### Update Order Row
POST {{appsScriptUrl}}
Content-Type: application/json
Accept: application/json

{
  "secret": "{{sharedSecret}}",
  "action": "updateOrder",
  "payload": {
    "order": {
      "order_id": "{{orderId}}",
      "invitation_slug": "{{invitationSlug}}",
      "created_at": "2026-03-12T10:00:00.000Z",
      "updated_at": "2026-03-13T08:15:00.000Z",
