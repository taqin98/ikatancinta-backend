POST {{appsScriptUrl}}
Content-Type: application/json
Accept: application/json

{
  "secret": "{{sharedSecret}}",
  "action": "listUploads",
  "payload": {}
}

### Create Wish
POST {{appsScriptUrl}}
Content-Type: application/json
Accept: application/json

{
  "secret": "{{sharedSecret}}",
  "action": "createWish",
  "payload": {
    "wish": {
      "invitationSlug": "{{invitationSlug}}",
      "name": "Rina",
      "attendance": "hadir",
      "message": "Semoga lancar sampai hari H.",
      "createdAt": "2026-03-12T10:00:00.000Z"
    }
  }
}

### List Wishes
POST {{appsScriptUrl}}
Content-Type: application/json
Accept: application/json

{
  "secret": "{{sharedSecret}}",
  "action": "listWishes",
  "payload": {
    "invitationSlug": "{{invitationSlug}}"
  }
}

