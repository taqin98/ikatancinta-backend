@appsScriptUrl = https://script.google.com/macros/s/AKfycbx7-KNkelesbkcBgz55UorderMZVPbXgLs9jLUZ9tbMPRsL4jz1RXVloFH1GyZCIzgR/exec
@sharedSecret = IKATANCINTA_SECRET
@orderId = IKC-260312-1234
@invitationSlug = bima-anisa-ikc-260312-1234

### Health
POST {{appsScriptUrl}}
Content-Type: application/json
Accept: application/json

{
  "secret": "{{sharedSecret}}",
  "action": "health",
  "payload": {}
}

